# Copy to backend/.env and fill in what you need. Everything here is optional:
# with an empty file the API runs on SQLite with rule-based analysis.

# PostgreSQL connection string. Leave unset to use backend/consumershield.db (SQLite).
# DATABASE_URL=postgresql://user:password@localhost:5432/consumershield

# Gemini insights (Tier 3). Without a key the backend uses its rule-based fallback.
# GEMINI_API_KEY=
# GEMINI_PRIMARY_MODEL=gemini-flash-lite-latest
# GEMINI_MODELS_TO_TRY=gemini-flash-lite-latest,gemini-flash-latest

# Local models. Need `pip install -r requirements-ml.txt`; Qwen needs a ~8 GB GPU.
# ENABLE_LOCAL_NLP=1
# ENABLE_QWEN_VL=1

# Tracker table override (defaults to backend/radar_lite.json).
# RADAR_LITE_PATH=

# Ethereum evidence anchoring (Sepolia). Leave unset to skip anchoring.
# RPC_URL=
# PRIVATE_KEY=
# CONTRACT_ADDRESS=
# ETH_CHAIN_ID=11155111
# ETH_RECEIPT_TIMEOUT_SEC=180
